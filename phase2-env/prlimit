#!/usr/bin/env python3
"""A stand-in for Linux's prlimit on macOS, for the one form PolicyWeave uses:

    prlimit --as=BYTES --cpu=SECONDS --fsize=BYTES -- COMMAND ARGS...

It sets the CPU-time and file-size limits with setrlimit, as prlimit does. macOS does not enforce an address-space
limit, so --as is attempted and otherwise ignored. PolicyWeave still kills the engine after its own 7-second timeout.
"""
import os
import resource
import sys

LIMITS = {'--as': resource.RLIMIT_AS, '--cpu': resource.RLIMIT_CPU, '--fsize': resource.RLIMIT_FSIZE}

args = sys.argv[1:]
if '--' not in args:
    sys.exit('prlimit stand-in: expected options, then --, then the command.')
split = args.index('--')
for option in args[:split]:
    name, _, value = option.partition('=')
    if name not in LIMITS or not value.isdigit():
        sys.exit(f'prlimit stand-in: unsupported option {option!r}.')
    try:
        resource.setrlimit(LIMITS[name], (int(value), int(value)))
    except (ValueError, OSError):
        if name != '--as':
            raise
command = args[split + 1:]
if not command:
    sys.exit('prlimit stand-in: no command given.')
os.execvp(command[0], command)
