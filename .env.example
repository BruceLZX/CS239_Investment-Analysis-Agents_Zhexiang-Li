# Copy to agent-team/.env (gitignored) and fill in. Never commit real values.

# Rakazo web origin; infra/setup-rakazo.sh serves it on port 5174.
RAKAZO_URL=http://127.0.0.1:5174

# SEC EDGAR's fair-access policy requires a contact in the User-Agent: "Your Name you@example.com".
SEC_USER_AGENT=

# Model the bots run on. Connect the DeepSeek key in Rakazo's model settings, not here.
MODEL_ID=deepseek-v4-pro
THINKING_LEVEL=high

# MCP server: where it listens, and the address Rakazo's containers use to reach it.
MCP_HOST=127.0.0.1
MCP_PORT=8766
MCP_ENDPOINT=http://host.docker.internal:8766/mcp
